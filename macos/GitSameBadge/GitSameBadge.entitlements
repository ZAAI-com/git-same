<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SwiftUI host entitlements (transitional; the host target is deleted in
  Phase C and replaced by the Tauri-built git-same.app). Kept buildable
  during Phase B.5 only so the renamed Badges extension can be embedded
  and verified end-to-end.

  Declares the same app group as the Badges extension so they share the
  IPC container at ~/Library/Group Containers/group.57KL6Y7V32.com.zaai.git-same/.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.57KL6Y7V32.com.zaai.git-same</string>
	</array>
</dict>
</plist>
